    {
      "parameters": {
        "jsCode": "// Format Products data\nconst products = $input.all();\nconst formattedProducts = [];\n\nfor (const item of products) {\n  const row = item.json;\n  \n  // Skip empty rows\n  if (!row.Ürün) continue;\n  \n  formattedProducts.push({\n    json: {\n      type: 'product',\n      name: row['Ürün'] || '',\n      description: row['Açıklama'] || '',\n      features: row['Özellikler'] || '',\n      price: row['Fiyat'] || '',\n      delivery: row['Teslimat'] || '',\n      warranty: row['Garanti'] || '',\n      content: `${row['Ürün'] || ''}: ${row['Açıklama'] || ''}. Özellikler: ${row['Özellikler'] || ''}. Fiyat: ${row['Fiyat'] || ''}. ${row['Teslimat'] || ''}. ${row['Garanti'] || ''}`\n    }\n  });\n}\n\nconsole.log(`Formatted ${formattedProducts.length} products`);\nreturn formattedProducts;"
      },
      "id": "format-products",
      "name": "Format Products",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Format FAQ data\nconst faqs = $input.all();\nconst formattedFaqs = [];\n\nfor (const item of faqs) {\n  const row = item.json;\n  \n  // Skip empty rows\n  if (!row.Soru) continue;\n  \n  formattedFaqs.push({\n    json: {\n      type: 'faq',\n      question: row['Soru'] || '',\n      answer: row['Cevap'] || '',\n      category: row['Kategori'] || 'Genel',\n      content: `S: ${row['Soru'] || ''}\\nC: ${row['Cevap'] || ''}`\n    }\n  });\n}\n\nconsole.log(`Formatted ${formattedFaqs.length} FAQs`);\nreturn formattedFaqs;"
      },
      "id": "format-faq",
      "name": "Format FAQ",
      "type": "n8n-nodes-base.code",
