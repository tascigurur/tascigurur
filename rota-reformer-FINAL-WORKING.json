        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Sen Rota Reformer satış asistanısın.\\n\\n=== ÜRÜN GÖRSELLERİ ===\\nGörsel istenirse:\\nÖrnek: Chair görselleri\\nCevap: Chair görsellerini gönderiyorum.\\n[IMAGE:Chair]\\n\\nÜRÜNLER: Combo Cadillac, Tower Reformer, Basic Reformer, Cadillac, Infinity Reformer, Metal Reformer, Katlanabilir Reformer, Chair, Barrel, Spine Corrector\\n\\n=== KATALOG ===\\nKatalog istenirse:\\nCevap: Katalogumuz aşağıda.\\n[CATALOG]\\n\\n=== FİYAT LİSTESİ ===\\nFiyat listesi istenirse:\\nCevap: 2025 fiyat listemiz aşağıda.\\n[PRICELIST]\\n\\n=== SATIŞ ===\\nSadece müşteri 'arasın' derse:\\nCevap: Koordinatörümüze ilettim.\\n[SALES]\\n\\nFİYATLAR:\\nCombo Cadillac: 62.000 TL + KDV\\nTower Reformer: 52.000 TL + KDV\\nChair: 28.000 TL (KDV Dahil)\\nBarrel: 24.000 TL (KDV Dahil)\\n\\nKURALLAR:\\n1. TAG'den ÖNCE mutlaka cevap mesajı yaz\\n2. Fiyat sorusu → TAG YOK, sadece cevap\\n3. TAG'den önce yeni satır\\n4. Max 1 TAG\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"={{ $json.body.data.message?.conversation || $json.body.data.message?.extendedTextMessage?.text || '' }}\"\n    }\n  ],\n  \"temperature\": 0.7\n}",
        "options": {}
      },
      "id": "openai-http",
      "name": "OpenAI API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 400],
      "credentials": {
        "openAiApi": {
          "id": "QHlET4NCnG3Pea5C",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const webhookData = $('Webhook').first().json;\nconst openaiResponse = $json;\n\nconst aiMessage = openaiResponse.choices[0].message.content;\nconst recipient = webhookData.body.data.key.remoteJid;\nconst recipientNumber = recipient.split('@')[0];\n\nconsole.log('=== AI RESPONSE ===');\nconsole.log(aiMessage);\nconsole.log('==================');\n\nconst hasImageTag = aiMessage.includes('[IMAGE:');\nconst hasCatalogTag = aiMessage.includes('[CATALOG]');\nconst hasPricelistTag = aiMessage.includes('[PRICELIST]');\nconst hasSalesTag = aiMessage.includes('[SALES]');\n\nlet productName = 'Chair';\nif (hasImageTag) {\n  const match = aiMessage.match(/\\[IMAGE:([^\\]]+)\\]/);\n  if (match) productName = match[1].trim();\n}\n\nlet cleanMessage = aiMessage\n  .replace(/\\[IMAGE:[^\\]]+\\]/g, '')\n  .replace(/\\[CATALOG\\]/g, '')\n  .replace(/\\[PRICELIST\\]/g, '')\n  .replace(/\\[SALES\\]/g, '')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\n// Boş mesaj kontrolü - failsafe\nif (!cleanMessage || cleanMessage.length === 0) {\n  if (hasCatalogTag) cleanMessage = 'Katalogumuz aşağıda.';\n  else if (hasPricelistTag) cleanMessage = '2025 fiyat listemiz aşağıda.';\n  else if (hasImageTag) cleanMessage = `${productName} görsellerini gönderiyorum.`;\n  else if (hasSalesTag) cleanMessage = 'Koordinatörümüze ilettim, en kısa sürede arayacak.';\n  else cleanMessage = 'Teşekkür ederim!';\n}\n\nreturn {\n  json: {\n    recipient: recipientNumber,\n    customerMessage: cleanMessage,\n    hasImageTag: hasImageTag,\n    hasCatalogTag: hasCatalogTag,\n    hasPricelistTag: hasPricelistTag,\n    hasSalesTag: hasSalesTag,\n    productName: productName,\n    fullAiResponse: aiMessage\n  }\n};"
      },
