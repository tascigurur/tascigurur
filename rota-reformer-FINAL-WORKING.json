      "parameters": {
        "jsCode": "const productName = $json.productName;\nconst recipient = $json.recipient;\n\nconst productImages = {\n  'Combo Cadillac': [\n    '179gnPSBg-_GkSkJgkogd6x7tOb0X3Q0P',\n    '1a3GTjcwaTU_zX1eyBztNQcD-k2J1M39L',\n    '1pJhgllPH3nBW2AWUA4ZIb2CTSQrctGcc'\n  ],\n  'Tower Reformer': [\n    '1ynee91yEKnbSAC-Re-DFD4U0LpWbIRhv',\n    '1HdglQ2VZ1qYdieTA8e2pGIxmL54MqPrU',\n    '19DSBRkRrjcA-XIx_cFgzSv0oSEvP3AKx'\n  ],\n  'Chair': [\n    '1qWfFKxd6HCpOio5DqEnURT8hBsE_CZMU',\n    '1BTJ7G91L05LbrzQI5OfeXWqt_fY1kg1R',\n    '1CVmiRauex3ZILPcevQeGVU3b_svH_b6_'\n  ],\n  'Barrel': [\n    '1ye7RmXboj41tt3-io08yqpKvn5iYVbb2',\n    '1zJs3TywJVXm9u1S08TueH9ymAc8mWjwx',\n    '1wDvHZsglZFhMW_iMrjMl7Dp8Yo6Sssy5'\n  ]\n};\n\nconst imageIds = productImages[productName] || productImages['Chair'];\n\nreturn imageIds.map((imageId, index) => ({\n  json: {\n    recipient: recipient,\n    mediaUrl: `https://drive.google.com/uc?export=download&id=${imageId}`,\n    caption: index === 0 ? productName : '',\n    isLast: index === imageIds.length - 1\n  }\n}));"
