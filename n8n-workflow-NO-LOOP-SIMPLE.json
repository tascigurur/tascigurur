      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.data.message?.conversation || $json.body.data.message?.extendedTextMessage?.text || '' }}",
        "options": {
          "systemMessage": "Sen profesyonel bir satış danışmanısın.\n\nÜRÜN GÖRSELLERİ:\n\nMüşteri: \"Chair fotoğrafları\"\nSen: \"Chair görsellerini gönderiyorum.\n\n[SEND_PRODUCT_IMAGES:Chair]\"\n\nTAG formatı: [SEND_PRODUCT_IMAGES:Ürün Adı]\n\nÜrün adları: Combo Cadillac, Tower Reformer, Basic Reformer, Cadillac, Infinity Reformer, Metal Reformer, Katlanabilir Reformer, Chair, Barrel, Spine Corrector\n\nDİĞER TAG'LER:\n[SEND_CATALOG] - Katalog\n[SEND_PRICE_LIST_IMAGE] - Fiyat listesi\n[SEND_COLOR_CARD] - Renk kartelası\n[SEND_TO_SALES_COORDINATOR] - Satış talebi\n[SEND_TO_TECHNICAL_SUPPORT] - Teknik destek\n\nFİYATLAR (2025):\n- Combo Cadillac: 62.000 TL + KDV\n- Tower Reformer: 52.000 TL + KDV\n- Chair: 28.000 TL (KDV Dahil)"
        }
      },
      "id": "ai-agent-node",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [440, 400]
    },
    {
      "parameters": {
        "jsCode": "const output = $json.output || '';\nconst webhookData = $('Webhook').item.json;\nconst recipient = webhookData.body.data.key.remoteJid;\n\nlet cleanOutput = output\n  .replace(/\\[SEND_TO_SALES_COORDINATOR\\]/g, '')\n  .replace(/\\[SEND_TO_TECHNICAL_SUPPORT\\]/g, '')\n  .replace(/\\[SEND_COLOR_CARD\\]/g, '')\n  .replace(/\\[SEND_CATALOG\\]/g, '')\n  .replace(/\\[SEND_PRICE_LIST_IMAGE\\]/g, '')\n  .replace(/\\[SEND_PRODUCT_IMAGES:[^\\]]+\\]/g, '')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nreturn {\n  json: {\n    output: output,\n    recipient: recipient,\n    recipientNumber: recipient.split('@')[0],\n    formatted_output: cleanOutput\n  }\n};"
      },
      "id": "format-output-node",
      "name": "Format Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 400]
    },
