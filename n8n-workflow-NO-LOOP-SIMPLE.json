    {
      "parameters": {
        "jsCode": "// Ürün ismini TAG'den çıkar\nconst formatOutput = $('Format Output').item.json;\nconst output = formatOutput.output || '';\nconst match = output.match(/\\[SEND_PRODUCT_IMAGES:([^\\]]+)\\]/);\nconst productName = match ? match[1].trim() : 'Chair';\n\n// Ürün görsellerini tanımla\nconst productImages = {\n  'Combo Cadillac': [\n    'https://drive.google.com/uc?export=download&id=179gnPSBg-_GkSkJgkogd6x7tOb0X3Q0P',\n    'https://drive.google.com/uc?export=download&id=1a3GTjcwaTU_zX1eyBztNQcD-k2J1M39L',\n    'https://drive.google.com/uc?export=download&id=1pJhgllPH3nBW2AWUA4ZIb2CTSQrctGcc'\n  ],\n  'Tower Reformer': [\n    'https://drive.google.com/uc?export=download&id=1ynee91yEKnbSAC-Re-DFD4U0LpWbIRhv',\n    'https://drive.google.com/uc?export=download&id=1HdglQ2VZ1qYdieTA8e2pGIxmL54MqPrU',\n    'https://drive.google.com/uc?export=download&id=19DSBRkRrjcA-XIx_cFgzSv0oSEvP3AKx'\n  ],\n  'Chair': [\n    'https://drive.google.com/uc?export=download&id=1qWfFKxd6HCpOio5DqEnURT8hBsE_CZMU',\n    'https://drive.google.com/uc?export=download&id=1BTJ7G91L05LbrzQI5OfeXWqt_fY1kg1R',\n    'https://drive.google.com/uc?export=download&id=1CVmiRauex3ZILPcevQeGVU3b_svH_b6_'\n  ],\n  'Barrel': [\n    'https://drive.google.com/uc?export=download&id=1ye7RmXboj41tt3-io08yqpKvn5iYVbb2',\n    'https://drive.google.com/uc?export=download&id=1zJs3TywJVXm9u1S08TueH9ymAc8mWjwx',\n    'https://drive.google.com/uc?export=download&id=1wDvHZsglZFhMW_iMrjMl7Dp8Yo6Sssy5'\n  ]\n};\n\nconst images = productImages[productName] || productImages['Chair'];\nconst recipientNumber = formatOutput.recipientNumber;\n\n// 3 ayrı output döndür - her biri bir görseli temsil eder\nreturn {\n  json: {\n    recipientNumber: recipientNumber,\n    productName: productName,\n    image1: images[0] || '',\n    image2: images[1] || '',\n    image3: images[2] || ''\n  }\n};"
      },
